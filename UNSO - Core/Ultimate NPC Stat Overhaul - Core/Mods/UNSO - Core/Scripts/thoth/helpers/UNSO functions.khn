-- ==================================== Barbarian ====================================

-- Consolidated
function UNSO_NPC_Barbarian_Subclass(source)
    source = source or context.Source
    if UNSO_NPC_Barbarian_Berserker(source).Result         then return ConditionResult(true) end
    if UNSO_NPC_Barbarian_Giant(source).Result             then return ConditionResult(true) end
    if UNSO_NPC_Barbarian_WildMagic(source).Result         then return ConditionResult(true) end
    if UNSO_NPC_Barbarian_Wildheart(source).Result         then return ConditionResult(true) end
    if UNSO_NPC_Barbarian_AncestralGuardian(source).Result then return ConditionResult(true) end
    if UNSO_NPC_Barbarian_Zealot(source).Result            then return ConditionResult(true) end
    return ConditionResult(false)
end

-- ==================================== Barbarian - Vanilla

function UNSO_NPC_Barbarian_Berserker(source)
    source = source or context.Source
    if HasPassive('LAB_Progression_Barbarian_Berserker', source).Result then return ConditionResult(true) end
    if HasPassive('CX_Barbarian_Berserker_Boost', source).Result        then return ConditionResult(true) end
    return ConditionResult(false)
end

function UNSO_NPC_Barbarian_Giant(source)
